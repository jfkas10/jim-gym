rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownUserId() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return signedIn() && ownUserId() == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(ownUserId())).data.role == "admin";
    }

    match /users/{userId} {
      // Owners can read themselves. Admins can read user profiles for the dashboard.
      allow read: if isOwner(userId) || isAdmin();

      // New registrations can only create their own profile as a normal user.
      allow create: if isOwner(userId)
                    && request.resource.data.role == "user";

      // Users can update their own profile, but cannot change the role.
      // v26.2 admin access is intentionally read-only for other users.
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);

      match /appData/{documentId} {
        // Admins may inspect all users' app data, but only owners can modify it.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }
    }
  }
}
