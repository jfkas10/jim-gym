rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function adminProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return adminProfileExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---------------- Private per-user application data ----------------

    match /users/{userId} {
      // Owners can read their own profile.
      // Admins can read profiles for the user-management dashboard.
      allow get, list: if isOwner(userId) || isAdmin();

      // New accounts may only create their own profile as a normal user.
      allow create: if isOwner(userId)
                    && request.resource.data.role == "user";

      // A client may update its own profile, but may never change its role.
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);

      match /appData/{documentId} {
        // Owners can read/write their own cloud state.
        // Admins can manage another user's app data through the explicit
        // full-user editor. Non-admin users remain owner-isolated.
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // ---------------- Shared gym/equipment library ----------------

    match /globalFitnessConfig/{documentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /globalGyms/{gymId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- Shared built-in exercise overrides ----------------

    match /sharedExerciseOverrides/{exerciseId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- James's read-only published progress ----------------
    //
    // This is deliberately separate from users/<uid>/appData.
    // All signed-in users can view it, but only the matching admin account
    // can publish or change it.

    match /publicProgress/{adminUid} {
      allow get, list: if signedIn();

      allow create, update, delete: if isOwner(adminUid) && isAdmin();

      match /appData/{documentId} {
        allow get, list: if signedIn();
        allow create, update, delete: if isOwner(adminUid) && isAdmin();
      }
    }
  }
}
